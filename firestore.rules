rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /calendar_rooms/{roomCode}
    // Document ID: roomCode (np. 'kodex')
    // Fields:
    //   - roomCode: string
    //   - pinHash: string
    //   - pinSalt: string
    //   - hostName: string
    //   - participants: list of strings
    //   - participantsData: map
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: /events/{eventId}
    // Document ID: eventId
    // Fields:
    //   - roomCode: string
    //   - calendarId: string
    //   - title: string
    //   - date: string
    //   - startTime: string
    //   - endTime: string
    //   - userId: string
    //   - userName: string
    //   - isExchangeable: bool
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: /exchanges/{exchangeId}
    // Document ID: exchangeId
    // Fields:
    //   - fromUserId: string
    //   - toUserId: string
    //   - fromUserEmail: string
    //   - toUserEmail: string
    //   - myEventId: string
    //   - targetEventId: string
    //   - status: string
    //   - createdAt: timestamp
    //   - resolvedAt: timestamp
    //
    // ===============================================================

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Kolekcja /calendar_rooms/{roomCode}
    match /calendar_rooms/{roomCode} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 2. Kolekcja /events/{eventId}
    match /events/{eventId} {
      // allow read: if request.auth != null;
      // Wymagane, aby zapytanie onSnapshot z where('roomCode', '==', roomCode)
      // oraz where('userId', '==', userId) działały bez błędu 'Missing or insufficient permissions'.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 3. Kolekcja /exchanges/{exchangeId}
    match /exchanges/{exchangeId} {
      allow read, write: if isAuthenticated();
    }
  }
}
